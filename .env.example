# Docker 部署配置（复制为 .env）
# 本地构建的镜像 tag：docker compose build 会生成 bluestarcoder/artex-redteam:<ARTEX_TAG>
# 镜像地址可用 ARTEX_IMAGE 整体覆盖（例如指向自己的仓库）
ARTEX_TAG=latest
# ARTEX_IMAGE=bluestarcoder/artex-redteam:latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
