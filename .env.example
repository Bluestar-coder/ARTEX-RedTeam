# Docker 部署配置（复制为 .env）
# 本地构建的镜像 tag：docker compose build 会生成 bluestarcoder/artex-redteam:<ARTEX_REDTEAM_TAG>
# 镜像地址可用 ARTEX_REDTEAM_IMAGE 整体覆盖（例如指向自己的仓库）
# 兼容说明：旧变量名 ARTEX_TAG / ARTEX_IMAGE 仍然有效（新名优先，未设置新名时才读旧名）。
ARTEX_REDTEAM_TAG=latest
# ARTEX_REDTEAM_IMAGE=bluestarcoder/artex-redteam:latest
# Postgres 账号/库名保持 artex 不变（历史兼容：带连字符的角色/库名需要额外引号）。
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
# 兼容说明：旧变量名 ARTEX_LLM_* 仍然有效（新名优先）。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_REDTEAM_LLM_PROVIDER=
ARTEX_REDTEAM_LLM_MODEL=
ARTEX_REDTEAM_LLM_BASE_URL=
ARTEX_REDTEAM_LLM_PROXY=
